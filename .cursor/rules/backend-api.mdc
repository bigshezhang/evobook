## 新 Feature 模板

创建新 feature 时，复制以下结构：

### router.ts

```typescript
import { z } from 'zod';
import { router, protectedProcedure } from '../../trpc';
import { myQuery, myMutation } from './service';

export const myFeatureRouter = router({
  get: protectedProcedure
    .input(z.object({ id: z.string().uuid() }))
    .query(async ({ ctx, input }) => {
      return await myQuery(ctx.db, ctx.userId, input.id);
    }),

  create: protectedProcedure
    .input(z.object({ name: z.string().min(1) }))
    .mutation(async ({ ctx, input }) => {
      return await myMutation(ctx.db, ctx.userId, input);
    }),
});
```

### service.ts

```typescript
import type { Database } from '../../db';
// import 需要的 schema 表

export interface MyResult { ... }

export async function myQuery(
  db: Database,
  userId: string,
  id: string,
): Promise<MyResult | null> {
  // Drizzle 查询
}

export async function myMutation(
  db: Database,
  userId: string,
  input: { name: string },
): Promise<MyResult> {
  // 业务逻辑 + DB 写入
}
```

### 注册到 root-router.ts

```typescript
import { myFeatureRouter } from './features/my-feature/router';

export const appRouter = router({
  // ...existing routes
  myFeature: myFeatureRouter,
});
```
