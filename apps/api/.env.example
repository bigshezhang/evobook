# 数据库
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/evobook

# Supabase Auth
SUPABASE_URL=https://your-project.supabase.co

# LLM (兼容 OpenAI API 格式)
LITELLM_MODEL=gpt-4o-mini
LITELLM_BASE_URL=https://api.openai.com/v1
LITELLM_API_KEY=sk-xxx

# 可选
API_PORT=8002
LLM_TIMEOUT=60
LLM_MAX_RETRIES=2
MOCK_LLM=false
